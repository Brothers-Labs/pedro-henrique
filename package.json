{
  "name": "pedro-henrique",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/generate-sitemap.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "gallery:manifest": "node scripts/generate-gallery-manifest.mjs",
    "prestart": "npm run gallery:manifest",
    "prebuild": "npm run gallery:manifest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc -p tsconfig.e2e.json",
    "test:ci": "node scripts/test-ci.mjs",
    "vtest": "playwright test",
    "verify": "npm audit --audit-level=high && npm run typecheck && npm run test:ci && npm run build && npm run vtest"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/forms": "^20.3.34",
    "@angular/platform-browser": "^20.3.34",
    "@angular/platform-server": "^20.3.34",
    "@angular/router": "^20.3.34",
    "@angular/service-worker": "^20.3.34",
    "@angular/ssr": "^20.3.42",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gsap": "3.15.0",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.42",
    "@angular/cli": "^20.3.42",
    "@angular/compiler-cli": "^20.3.34",
    "@playwright/test": "^1.64.1",
    "@types/jasmine": "~5.1.0",
    "@types/three": "^0.186.0",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2"
  }
}
