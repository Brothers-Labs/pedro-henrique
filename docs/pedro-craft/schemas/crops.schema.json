{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedrohenrique.app/schemas/pedro-craft/crops.schema.json",
  "title": "PedroCraft — plantações",
  "type": "object",
  "required": ["schemaVersion", "crops"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "crops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "block", "seed", "stages", "stageMs", "soil", "mature"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "block": { "$ref": "common.schema.json#/$defs/id", "description": "Bloco que representa a planta no mundo." },
          "seed": { "$ref": "common.schema.json#/$defs/id", "description": "Item que planta; precisa de \"plants\" apontando de volta." },
          "stages": { "type": "integer", "minimum": 1, "maximum": 8 },
          "stageMs": { "type": "integer", "minimum": 1000 },
          "wateredSpeedup": { "type": "number", "minimum": 1, "maximum": 5, "default": 1 },
          "soil": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/id" } },
          "mature": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "loot"],
                "additionalProperties": false,
                "properties": { "type": { "const": "harvest" }, "loot": { "$ref": "common.schema.json#/$defs/id" } }
              },
              {
                "type": "object",
                "required": ["type", "log", "leaves", "minHeight", "maxHeight"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "tree" },
                  "log": { "$ref": "common.schema.json#/$defs/id" },
                  "leaves": { "$ref": "common.schema.json#/$defs/id" },
                  "minHeight": { "type": "integer", "minimum": 3, "maximum": 10 },
                  "maxHeight": { "type": "integer", "minimum": 3, "maximum": 10 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
