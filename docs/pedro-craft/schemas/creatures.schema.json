{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedrohenrique.app/schemas/pedro-craft/creatures.schema.json",
  "title": "PedroCraft — criaturas",
  "type": "object",
  "required": ["schemaVersion", "creatures"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "creatures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/creature" } }
  },
  "$defs": {
    "creature": {
      "type": "object",
      "required": ["id", "name", "temperament", "health", "speed", "behavior", "model", "colors", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "temperament": {
          "enum": ["passive", "hostile", "guardian"],
          "description": "guardian é o amigo que a criança chama com um item (o golem): segue o herói, enfrenta os inimigos e não nasce sozinho."
        },
        "health": { "type": "integer", "minimum": 1, "maximum": 100 },
        "speed": { "type": "number", "minimum": 0.1, "maximum": 10, "description": "Blocos por segundo." },
        "damage": { "type": "integer", "minimum": 0, "maximum": 10, "default": 0, "description": "Corações por ataque." },
        "attackCooldownMs": { "type": "integer", "minimum": 200, "default": 1000 },
        "behavior": { "enum": ["grazer", "chaser", "hopper", "archer"] },
        "model": { "enum": ["chicken", "cow", "sheep", "slime", "king-slime", "scarecrow", "spider", "skeleton", "creeper", "iron-golem", "verity", "lovity", "falsity", "cruelty", "obesity", "squareity", "pointy", "maker-hero"], "description": "maker-hero: boneco de um herói do Pedro Maker, escolhido em \"hero\"." },
        "colors": { "$ref": "common.schema.json#/$defs/colors" },
        "width": { "type": "number", "minimum": 0.2, "maximum": 2 },
        "height": { "type": "number", "minimum": 0.2, "maximum": 2.5 },
        "drops": { "anyOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] },
        "spawn": {
          "type": ["object", "null"],
          "required": ["period", "on", "groupMin", "groupMax", "weight"],
          "additionalProperties": false,
          "properties": {
            "period": { "enum": ["day", "night"] },
            "on": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/id" } },
            "groupMin": { "type": "integer", "minimum": 1, "maximum": 6 },
            "groupMax": { "type": "integer", "minimum": 1, "maximum": 6 },
            "weight": { "type": "number", "minimum": 0.1, "maximum": 100 }
          }
        },
        "splitInto": {
          "type": ["object", "null"],
          "required": ["creature", "count"],
          "additionalProperties": false,
          "properties": {
            "creature": { "$ref": "common.schema.json#/$defs/id" },
            "count": { "type": "integer", "minimum": 1, "maximum": 4 }
          }
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item"],
            "additionalProperties": false,
            "properties": {
              "item": { "$ref": "common.schema.json#/$defs/id" },
              "loot": { "anyOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] },
              "convertsItemTo": { "anyOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] },
              "cooldownMs": { "type": "integer", "minimum": 0, "default": 0 }
            },
            "anyOf": [{ "required": ["loot"] }, { "required": ["convertsItemTo"] }]
          }
        },
        "lays": {
          "type": ["object", "null"],
          "required": ["item", "everyMs"],
          "additionalProperties": false,
          "properties": {
            "item": { "$ref": "common.schema.json#/$defs/id" },
            "everyMs": { "type": "integer", "minimum": 1000 }
          }
        },
        "breedsWith": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/id" }], "description": "Comida que faz dois animais iguais terem um filhote." },
        "babyGrowMs": { "type": "integer", "minimum": 10000, "default": 300000, "description": "Quanto o filhote leva para crescer." },
        "hero": { "type": "string", "minLength": 1, "description": "Só no modelo maker-hero: id do herói do Pedro Maker (pedro, gui, mario, peach...)." },
        "greeting": { "type": "string", "minLength": 1, "description": "O que a criatura fala (na tela e em voz alta) quando o herói toca nela com o botão de usar." },
        "explodes": {
          "type": ["object", "null"],
          "description": "Em vez de golpear, chia perto do herói e estoura (o creeper). Só para inimigos.",
          "required": ["fuseMs", "radius", "damage"],
          "additionalProperties": false,
          "properties": {
            "fuseMs": { "$ref": "common.schema.json#/$defs/fuseMs" },
            "radius": { "$ref": "common.schema.json#/$defs/blastRadius" },
            "damage": { "$ref": "common.schema.json#/$defs/blastDamage" },
            "breaksBlocks": { "type": "boolean", "default": false, "description": "Abre buraco no mundo; o creeper não abre, para não desmanchar construções." }
          }
        }
      }
    }
  }
}
