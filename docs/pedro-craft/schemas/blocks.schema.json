{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedrohenrique.app/schemas/pedro-craft/blocks.schema.json",
  "title": "PedroCraft — blocos",
  "type": "object",
  "required": ["schemaVersion", "blocks"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "blocks": { "type": "array", "minItems": 1, "maxItems": 255, "items": { "$ref": "#/$defs/block" } }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["id", "name", "shape", "solid", "transparent", "mapColor", "textures"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id", "not": { "const": "air" } },
        "name": { "type": "string", "minLength": 1, "description": "Nome mostrado na tela, em português." },
        "shape": { "enum": ["cube", "cross", "liquid", "torch", "fence", "slab", "rail", "carpet", "half", "wire"], "description": "carpet: tapete fininho no chão; não pode ser sólido e precisa de chão firme embaixo. half: meio bloco, sólido e com collisionHeight 0.5. wire: a linha do circuito, deitada no chão; só para blocos com circuit.role \"wire\"." },
        "solid": { "type": "boolean" },
        "transparent": { "type": "boolean", "description": "Tem partes vazadas e não esconde as faces dos vizinhos." },
        "hardness": { "type": ["number", "null"], "minimum": 0, "maximum": 60, "description": "Segundos com a mão; null = não quebra." },
        "tool": { "anyOf": [{ "$ref": "common.schema.json#/$defs/toolType" }, { "type": "null" }] },
        "minTier": { "type": "integer", "minimum": 0, "maximum": 5, "default": 0 },
        "drops": { "anyOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }], "description": "Id em loot-tables.json." },
        "light": { "type": "integer", "minimum": 0, "maximum": 15, "default": 0 },
        "collisionHeight": { "type": "number", "minimum": 0.1, "maximum": 1.5, "default": 1 },
        "replaceable": { "type": "boolean", "default": false },
        "pairsVertically": { "type": "boolean", "default": false },
        "toggleInto": { "anyOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }], "description": "Id de bloco." },
        "interaction": { "enum": ["workbench", "furnace", "chest", "bed", null] },
        "blastResistant": { "type": "boolean", "default": false, "description": "Aguenta explosão sem quebrar (a obsidiana)." },
        "explosive": {
          "type": ["object", "null"],
          "description": "Bloco que estoura depois de aceso com um dos itens `igniters` na mão (a TNT). Não pode ter blastResistant.",
          "required": ["fuseMs", "radius", "damage", "igniters"],
          "additionalProperties": false,
          "properties": {
            "fuseMs": { "$ref": "common.schema.json#/$defs/fuseMs" },
            "radius": { "$ref": "common.schema.json#/$defs/blastRadius" },
            "damage": { "$ref": "common.schema.json#/$defs/blastDamage" },
            "breaksBlocks": { "type": "boolean", "default": false, "description": "Abre buraco no mundo." },
            "igniters": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "common.schema.json#/$defs/id" },
              "description": "Ids dos itens que acendem (a tocha, o isqueiro). Um item com durabilidade perde um uso a cada pavio aceso."
            }
          }
        },
        "portal": {
          "type": ["object", "null"],
          "description": "Bloco que enche o vão de uma moldura em pé de `frame` (de 2 × 3 até 10 × 10, cantos opcionais) quando um dos `igniters` é usado nela. Leva o herói até outro portal igual. Não pode ser sólido.",
          "required": ["frame", "igniters"],
          "additionalProperties": false,
          "properties": {
            "frame": { "$ref": "common.schema.json#/$defs/id", "description": "Id do bloco da moldura." },
            "igniters": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "common.schema.json#/$defs/id" },
              "description": "Ids dos itens que acendem (o isqueiro). Um item com durabilidade perde um uso a cada portal aceso."
            }
          }
        },
        "circuit": {
          "type": ["object", "null"],
          "description": "Peça de circuito. source: a alavanca, que o herói troca pelo toggleInto; wire: a linha, que leva o comando; receiver: muda de jeito quando o comando chega (a porta). Uma TNT encostada no comando ligado acende sozinha.",
          "required": ["role", "powered"],
          "additionalProperties": false,
          "properties": {
            "role": { "enum": ["source", "wire", "receiver"] },
            "powered": { "type": "boolean", "description": "Este é o jeito ligado (alavanca ligada, linha acesa, porta aberta)." },
            "switchesInto": {
              "anyOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }],
              "description": "Id do mesmo bloco no outro jeito, que volta para este. Obrigatório em wire e receiver; proibido em source."
            }
          }
        },
        "stacksInto": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }],
          "description": "Só em meio bloco (shape half): outro igual colocado em cima vira este bloco inteiro (shape cube)."
        },
        "mapColor": { "$ref": "common.schema.json#/$defs/color" },
        "textures": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": { "$ref": "common.schema.json#/$defs/texture" },
            "top": { "$ref": "common.schema.json#/$defs/texture" },
            "side": { "$ref": "common.schema.json#/$defs/texture" },
            "bottom": { "$ref": "common.schema.json#/$defs/texture" }
          },
          "anyOf": [{ "required": ["all"] }, { "required": ["top", "side", "bottom"] }]
        }
      }
    }
  }
}
