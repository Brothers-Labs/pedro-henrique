{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedrohenrique.app/schemas/pedro-craft/recipes.schema.json",
  "title": "PedroCraft — receitas",
  "type": "object",
  "required": ["schemaVersion", "crafting", "smelting", "fuels"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "crafting": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/crafting" } },
    "smelting": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "input", "output", "timeMs"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "input": { "$ref": "common.schema.json#/$defs/id" },
          "output": { "$ref": "common.schema.json#/$defs/itemAmount" },
          "timeMs": { "type": "integer", "minimum": 500 }
        }
      }
    },
    "fuels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "burnMs"],
        "additionalProperties": false,
        "properties": {
          "item": { "$ref": "common.schema.json#/$defs/id" },
          "burnMs": { "type": "integer", "minimum": 500 }
        }
      }
    }
  },
  "$defs": {
    "crafting": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "type", "station", "pattern", "key", "output"],
          "additionalProperties": false,
          "description": "Receita com forma: o desenho pode estar em qualquer canto da grade e também vale espelhado.",
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/id" },
            "type": { "const": "shaped" },
            "station": { "enum": ["hand", "workbench"], "description": "hand = grade 2 × 2; workbench = grade 3 × 3." },
            "pattern": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "maxLength": 3 } },
            "key": {
              "type": "object",
              "propertyNames": { "pattern": "^[^ ]$" },
              "additionalProperties": { "$ref": "common.schema.json#/$defs/id" }
            },
            "output": { "$ref": "common.schema.json#/$defs/itemAmount" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "station", "ingredients", "output"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/id" },
            "type": { "const": "shapeless" },
            "station": { "enum": ["hand", "workbench"] },
            "ingredients": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/itemAmount" } },
            "output": { "$ref": "common.schema.json#/$defs/itemAmount" }
          }
        }
      ]
    }
  }
}
