{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedrohenrique.app/schemas/pedro-craft/world.schema.json",
  "title": "PedroCraft — mundo",
  "description": "Regras do gerador de mundo, do relógio, das criaturas e do herói. O mesmo arquivo com a mesma semente gera sempre o mesmo mundo.",
  "type": "object",
  "required": [
    "schemaVersion", "width", "depth", "height", "chunkSize", "seaLevel", "blocks", "terrain", "lake", "river", "forest",
    "quarry", "farm", "tree", "decorationChance", "house", "clock", "water", "creatures", "hero"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "width": { "type": "integer", "minimum": 8, "maximum": 256, "description": "Múltiplo de chunkSize." },
    "depth": { "type": "integer", "minimum": 8, "maximum": 256, "description": "Múltiplo de chunkSize." },
    "height": { "type": "integer", "minimum": 16, "maximum": 64 },
    "chunkSize": { "type": "integer", "minimum": 8, "maximum": 32 },
    "seaLevel": { "type": "integer", "minimum": 2 },
    "blocks": {
      "type": "object",
      "required": ["surface", "soil", "stone", "sand", "gravel", "water", "bedrock", "log", "leaves", "decorations"],
      "additionalProperties": false,
      "properties": {
        "surface": { "$ref": "common.schema.json#/$defs/id" },
        "soil": { "$ref": "common.schema.json#/$defs/id" },
        "stone": { "$ref": "common.schema.json#/$defs/id" },
        "sand": { "$ref": "common.schema.json#/$defs/id" },
        "gravel": { "$ref": "common.schema.json#/$defs/id" },
        "water": { "$ref": "common.schema.json#/$defs/id" },
        "bedrock": { "$ref": "common.schema.json#/$defs/id" },
        "log": { "$ref": "common.schema.json#/$defs/id" },
        "leaves": { "$ref": "common.schema.json#/$defs/id" },
        "decorations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "description": "Repetir um id aumenta a chance dele." }
      }
    },
    "terrain": {
      "type": "object",
      "required": ["baseHeight", "hillAmplitude", "hillScale", "edgeWidth"],
      "additionalProperties": false,
      "properties": {
        "baseHeight": { "type": "integer" },
        "hillAmplitude": { "type": "number", "minimum": 0 },
        "hillScale": { "type": "number", "minimum": 4, "maximum": 200 },
        "edgeWidth": { "type": "integer", "minimum": 1, "maximum": 16, "description": "Faixa da borda que afunda até virar água." }
      }
    },
    "lake": { "$ref": "#/$defs/integers", "required": ["radius", "depth"] },
    "river": {
      "type": "object",
      "required": ["width", "meander"],
      "additionalProperties": false,
      "properties": { "width": { "type": "integer", "minimum": 1, "maximum": 6 }, "meander": { "type": "number", "minimum": 0, "maximum": 20 } }
    },
    "forest": {
      "type": "object",
      "required": ["radius", "treeChance"],
      "additionalProperties": false,
      "properties": { "radius": { "type": "integer", "minimum": 4, "maximum": 48 }, "treeChance": { "type": "number", "minimum": 0, "maximum": 0.2 } }
    },
    "quarry": {
      "type": "object",
      "required": ["radius", "height", "ores"],
      "additionalProperties": false,
      "properties": {
        "radius": { "type": "integer", "minimum": 3, "maximum": 32 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16 },
        "ores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["block", "chance", "maxY"],
            "additionalProperties": false,
            "properties": {
              "block": { "$ref": "common.schema.json#/$defs/id" },
              "chance": { "type": "number", "minimum": 0, "maximum": 0.5 },
              "maxY": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "farm": { "$ref": "#/$defs/integers", "required": ["radius"] },
    "tree": { "$ref": "#/$defs/integers", "required": ["minHeight", "maxHeight"] },
    "decorationChance": { "type": "number", "minimum": 0, "maximum": 0.5 },
    "house": {
      "type": "object",
      "required": ["palette", "layers"],
      "additionalProperties": false,
      "description": "Casa inicial em camadas, do chão para cima. layers[y][z] é uma linha de letras ao longo de x; \".\" é ar.",
      "properties": {
        "palette": {
          "type": "object",
          "propertyNames": { "pattern": "^[^.]$" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/id" }
        },
        "layers": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
      }
    },
    "clock": { "$ref": "#/$defs/integers", "required": ["dayMs", "nightMs"] },
    "water": { "$ref": "#/$defs/integers", "required": ["maxSpread", "tickMs"] },
    "creatures": {
      "type": "object",
      "required": ["passiveCap", "hostileCap", "spawnIntervalMs", "minSpawnDistance", "maxSpawnDistance", "torchSafeRadius"],
      "additionalProperties": false,
      "properties": {
        "passiveCap": { "type": "integer", "minimum": 0, "maximum": 40 },
        "hostileCap": { "type": "integer", "minimum": 0, "maximum": 40 },
        "spawnIntervalMs": { "type": "integer", "minimum": 250 },
        "minSpawnDistance": { "type": "number", "minimum": 4 },
        "maxSpawnDistance": { "type": "number", "maximum": 128 },
        "torchSafeRadius": { "type": "number", "minimum": 0, "maximum": 32 }
      }
    },
    "hero": {
      "type": "object",
      "required": ["maxHealth", "regenEveryMs", "reach", "invulnerableMs", "startingInventory"],
      "additionalProperties": false,
      "properties": {
        "maxHealth": { "type": "integer", "minimum": 1, "maximum": 20, "description": "Em corações." },
        "regenEveryMs": { "type": "integer", "minimum": 500 },
        "reach": { "type": "number", "minimum": 2, "maximum": 8 },
        "invulnerableMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "startingInventory": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/itemAmount" } }
      }
    }
  },
  "$defs": {
    "integers": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
